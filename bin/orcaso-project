#!/usr/bin/env bash
#
# Deja montado el proyecto en Orca con las pestañas básicas: el CLI de IA que
# uses y Slack. La idea es no tener que salir de Orca para nada.
#
#   orcaso-project [--focus] [--slack terminal|web|none] [--web <url>] [--cli <cmd>]
#
#   --focus        deja el foco en la última pestaña creada
#   --slack <modo> terminal (weeslack, por defecto), web (Slack en el navegador
#                  de Orca) o none
#   --web <url>    abre además una pestaña del navegador de Orca
#   --cli <cmd>    fuerza el CLI de IA (si no, se detecta)
#
# Es idempotente: si ya existe una pestaña con ese título en este worktree, no
# crea otra.

set -uo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)"

# Mismos ajustes de máquina que usa install.sh. La forma ': "${VAR:=valor}"'
# hace que lo que venga del entorno o de la línea de comandos siga mandando.
if [ -f "$REPO_DIR/weechat/local.env" ]; then
  # shellcheck source=/dev/null
  . "$REPO_DIR/weechat/local.env"
fi

WORKTREE="${ORCA_WORKTREE:-path:$REPO_DIR}"
FOCUS=""
WEB_URL="${ORCASO_WEB_URL:-}"
AI_CLI="${ORCASO_AI_CLI:-}"
SLACK_MODE="${ORCASO_SLACK:-terminal}"
# Conviene poner la URL del workspace (https://<equipo>.slack.com) en
# weechat/local.env: la genérica redirige a la pantalla de elegir espacio.
SLACK_URL="${ORCASO_SLACK_URL:-https://app.slack.com/client}"

while [ $# -gt 0 ]; do
  case "$1" in
    --focus) FOCUS="--focus" ;;
    --web)   WEB_URL="$2"; shift ;;
    --slack) SLACK_MODE="$2"; shift ;;
    --cli)   AI_CLI="$2"; shift ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "Opción desconocida: $1" >&2; exit 1 ;;
  esac
  shift
done

log()  { printf '\033[1;34m==>\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$1"; }

command -v orca >/dev/null 2>&1 || { echo "La CLI de Orca no está en el PATH." >&2; exit 1; }

# jq si está; si no, el python del sistema. Solo se usa para leer la salida
# --json de la CLI de Orca.
json_get() {
  if command -v jq >/dev/null 2>&1; then jq -r "$1"
  else /usr/bin/python3 -c "
import json,sys
d=json.load(sys.stdin)
for t in d.get('result',{}).get('terminals',[]):
    print((t.get('title') or '') + '\t' + (t.get('worktreePath') or '') + '\t' + (t.get('agentIdentity') or ''))
"
  fi
}

terminals_json() { orca terminal list --json 2>/dev/null; }

# Título + worktree + agente de cada terminal viva, en TSV.
terminals_tsv() {
  if command -v jq >/dev/null 2>&1; then
    terminals_json | jq -r '.result.terminals[]? | [.title // "", .worktreePath // "", .agentIdentity // ""] | @tsv'
  else
    terminals_json | json_get ''
  fi
}

# ---------------------------------------------- qué CLI de IA lanzar
# Prioridad: --cli / ORCASO_AI_CLI  >  el agente que Orca ya tiene en marcha  >
# la cuenta gestionada por Orca  >  el primero instalado.
detect_cli() {
  [ -n "$AI_CLI" ] && { echo "$AI_CLI"; return; }

  local agent
  agent="$(terminals_tsv | awk -F'\t' '$3 != "" {print $3; exit}')"
  if [ -n "$agent" ] && command -v "$agent" >/dev/null 2>&1; then
    echo "$agent"; return
  fi

  local accounts; accounts="$(orca account list 2>/dev/null)"
  case "$accounts" in
    *"Managed Claude accounts ("*) command -v claude >/dev/null 2>&1 && { echo claude; return; } ;;
  esac
  case "$accounts" in
    *"Managed Codex accounts ("*) command -v codex >/dev/null 2>&1 && { echo codex; return; } ;;
  esac

  for c in claude codex opencode cursor-agent aider; do
    command -v "$c" >/dev/null 2>&1 && { echo "$c"; return; }
  done
}

# ---------------------------------------------- pestañas
has_terminal() {
  # $1 = título buscado. Orca antepone un glifo de estado al título.
  terminals_tsv | awk -F'\t' -v t="$1" -v w="$REPO_DIR" \
    'index($1, t) > 0 && $2 == w { found = 1 } END { exit !found }'
}

create_terminal() {
  local title="$1" cmd="$2"
  if has_terminal "$title"; then
    log "La pestaña «${title}» ya existe"
    return
  fi
  if [ -n "$cmd" ]; then
    orca terminal create --worktree "$WORKTREE" --title "$title" --command "$cmd" $FOCUS --json >/dev/null \
      && log "Pestaña «${title}» → $cmd"
  else
    orca terminal create --worktree "$WORKTREE" --title "$title" $FOCUS --json >/dev/null \
      && log "Pestaña «${title}»"
  fi
}

open_web_tab() {
  local url="$1" label="$2" host existing=""
  # Se compara por host y no por URL completa: Slack redirige al abrir, así que
  # la URL de la pestaña ya no es la que se pidió.
  host="${url#*://}"; host="${host%%/*}"
  if command -v jq >/dev/null 2>&1; then
    existing="$(orca tab list --json 2>/dev/null \
      | jq -r --arg h "$host" '.result.tabs[]? | select(.url | contains($h)) | .browserPageId' | head -1)"
  fi
  if [ -n "$existing" ]; then
    log "La pestaña de $label ya está abierta"
    return
  fi
  orca tab create --worktree "$WORKTREE" --url "$url" --json >/dev/null \
    && log "Pestaña del navegador → $label"
}

# ---------------------------------------------------------------------- main
orca repo add --path "$REPO_DIR" --json >/dev/null 2>&1 || true

cli="$(detect_cli)"
if [ -n "$cli" ]; then
  # "claude" -> "Claude"
  title="$(printf '%s' "${cli%% *}" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
  create_terminal "$title" "$cli"
else
  warn "No encontré ningún CLI de IA instalado; me salto esa pestaña"
fi

case "$SLACK_MODE" in
  terminal)
    # Dos WeeChat a la vez se pelean por el mismo directorio de configuración,
    # así que si ya hay uno corriendo no se abre otra pestaña.
    if pgrep -x weechat >/dev/null 2>&1; then
      warn "Ya hay un WeeChat corriendo; no creo la pestaña de Slack"
    else
      create_terminal "Slack" "$REPO_DIR/bin/weeslack"
    fi
    ;;
  web)
    open_web_tab "$SLACK_URL" "Slack"
    ;;
  none) ;;
  *) warn "Modo de Slack desconocido: $SLACK_MODE (usa terminal, web o none)" ;;
esac

[ -n "$WEB_URL" ] && open_web_tab "$WEB_URL" "$WEB_URL"

log "Proyecto listo en Orca."
