#!/usr/bin/env bash
# Lanza el slack-tui parcheado que define nix/flake.nix.
#
# No está en devbox.json a propósito: es un extra, no una dependencia del
# repositorio. Los parches que lleva están en nix/patches/.
set -euo pipefail
REPO_DIR="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)"
export NIX_CONFIG="${NIX_CONFIG:-experimental-features = nix-command flakes}"
exec nix run "$REPO_DIR/nix#slack-tui" -- "$@"
