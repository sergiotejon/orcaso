From 2eb43c472ada36a76da22d91ca7c13896900854c Mon Sep 17 00:00:00 2001
From: orcaso <orcaso@localhost>
Date: Fri, 4 Sep 2026 16:40:12 +0200
Subject: [PATCH 1/2] source: list conversations with users.conversations

conversations.list walks the entire workspace and then discards
everything but IsMember. On a company workspace that is hundreds of
paginated calls -- Slack returns pages far smaller than the requested
limit (28, 30, 6, 4, 3...) and Tier-2 rate limiting kicks in after
about seven of them with HTTP 429, Retry-After: 30. Startup took over
twelve minutes before the UI could paint.

users.conversations returns only the caller's memberships, so the same
sidebar is one short paginated walk. It does not populate is_member --
everything it returns is a membership by definition -- so the filter
becomes the default branch.

The channel browser keeps conversations.list: browsing joinable
channels is exactly the case where the whole workspace is the point.
---
 internal/source/slack.go          |  9 +++++++--
 internal/source/slack_api_test.go | 15 +++++++--------
 2 files changed, 14 insertions(+), 10 deletions(-)

diff --git a/internal/source/slack.go b/internal/source/slack.go
index 7fdfa7d..b5ec404 100644
--- a/internal/source/slack.go
+++ b/internal/source/slack.go
@@ -95,7 +95,12 @@ func (s *Slack) Load() (*data.Workspace, error) {
 	var channels, dms []data.Conversation
 	cursor := ""
 	for {
-		convs, next, err := s.api.GetConversations(&slack.GetConversationsParameters{
+		// users.conversations returns only the conversations this user belongs
+		// to. conversations.list walks the entire workspace and then throws
+		// away everything but IsMember, which on a company workspace means
+		// hundreds of paginated calls and Tier-2 rate limiting (HTTP 429,
+		// Retry-After: 30) before the UI can start.
+		convs, next, err := s.api.GetConversationsForUser(&slack.GetConversationsForUserParameters{
 			Types: types, ExcludeArchived: true, Limit: 200, Cursor: cursor,
 		})
 		if err != nil {
@@ -110,7 +115,7 @@ func (s *Slack) Load() (*data.Workspace, error) {
 				dms = append(dms, data.Conversation{ID: c.ID, Type: "dm", UserID: c.User})
 			case c.IsMpIM:
 				dms = append(dms, data.Conversation{ID: c.ID, Type: "dm", Name: mpimName(c.Name)})
-			case c.IsMember:
+			default: // users.conversations only returns memberships, so IsMember is redundant (and unset)
 				channels = append(channels, data.Conversation{ID: c.ID, Type: "channel", Name: c.Name, Topic: c.Topic.Value})
 			}
 		}
diff --git a/internal/source/slack_api_test.go b/internal/source/slack_api_test.go
