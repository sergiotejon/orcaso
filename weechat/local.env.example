# Ajustes de esta máquina. Copia este fichero a weechat/local.env (que git
# ignora) y ajusta los valores; install.sh lo carga si existe.
#
# La forma ': "${VAR:=valor}"' significa "solo si no viene ya del entorno", así
# que la precedencia es: opciones de la línea de comandos > variables de
# entorno > este fichero > los valores por defecto del repositorio.

# Nombre del workspace de Slack, tal y como quieres que aparezca en WeeChat.
: "${SLACK_WORKSPACE:=miequipo}"

# Canal al que saltar al arrancar. El prefijo importa:
#   '#' canal público   '&' canal privado   '@' grupo   (nada) DM
: "${SLACK_DEFAULT_CHANNEL:=&equipo-privado}"

# Cómo montar Slack en Orca:
#   terminal  WeeChat (por defecto)
#   tui       slack-tui, el paquete opcional de nix/flake.nix
#   web       el cliente web en una pestaña del navegador de Orca
#   none
# : "${ORCASO_SLACK:=terminal}"

# Si usas el modo web, pon la URL de tu workspace: la genérica redirige a la
# pantalla de "encuentra tu espacio de trabajo".
# : "${ORCASO_SLACK_URL:=https://miequipo.slack.com}"

# CLI de IA para la pestaña del agente. Si no se pone, se detecta.
# : "${ORCASO_AI_CLI:=codex}"

# El token puede ir aquí para instalaciones desatendidas, pero quedaría en
# texto plano en el directorio del repositorio. Es preferible dejar que
# install.sh lo pida, y después cifrarlo con /secure (ver MANUAL.md §3).
# : "${SLACK_TOKEN:=xoxc-...}"
# : "${SLACK_COOKIE:=d=xoxd-...}"
